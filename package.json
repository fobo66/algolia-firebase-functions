{
  "name": "algolia-firebase-functions",
  "version": "7.0.0",
  "description": "Cloud Functions for sync Firebase Database with Algolia in real time",
  "license": "Apache-2.0",
  "homepage": "https://fobo66.github.io/algolia-firebase-functions/",
  "type": "module",
  "engines": {
    "node": ">= 20"
  },
  "files": ["dist"],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": {
    "name": "Andrey Mukamolov",
    "email": "fobo66@fastmail.com",
    "url": "https://fobo66.dev"
  },
  "contributors": [
    "Yuri Oliveira <yuri@matsya.io> (https://github.com/yuriploc)"
  ],
  "keywords": ["algolia", "firebase", "search"],
  "repository": {
    "type": "git",
    "url": "https://github.com/fobo66/algolia-firebase-functions"
  },
  "bugs": {
    "url": "https://github.com/fobo66/algolia-firebase-functions/issues"
  },
  "scripts": {
    "build": "tsc",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "docs": "typedoc --out ./out --readme README.md index.ts",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@algolia/client-search": "5.57.0",
    "firebase-admin": "13.10.0",
    "firebase-functions": "7.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@vitest/coverage-v8": "5.0.0",
    "firebase-functions-test": "3.5.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "vitest-mock-extended": "5.1.1"
  },
  "lint-staged": {
    "*.ts": ["biome check --write"],
    "*.{js,mjs,json,md}": "biome check --write"
  }
}
